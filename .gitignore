# Built index artifacts (~14 GB SQuAD + ~2.8 GB TriviaQA) -- regenerate with the build scripts
SQUAD/f16/
SQUAD/q4/
TRIVIAQA/f16/
TRIVIAQA/q4/

# Frozen corpora (~109 MB) -- regenerate with freeze_squad_train_multi.py / freeze_triviaqa.py
data/*.jsonl

# Per-question evaluation dumps (large); the summaries in SQUAD/results are tracked
SQUAD/results/*_v*.json
node_exclusive_qa/

# Local model weights
*.gguf
models/

# Cluster logs and credentials
logs/
.telegram_creds

# LaTeX intermediates
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz

__pycache__/
*.pyc
.venv/
